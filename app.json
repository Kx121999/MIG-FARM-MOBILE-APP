{
  "expo": {
    "name": "MIG FARM | ميغ فارم",
    "slug": "mig-farm-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "migfarm",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.migfarm.app"
    },
    "android": {
      "package": "com.migfarm.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F8F2"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نستخدم صورك لتحليل حالة النبات أو قراءة ملصق المنتج.",
          "cameraPermission": "نستخدم الكاميرا لتصوير النبات أو المنتج وتحليله.",
          "microphonePermission": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.migfarm.app",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://127.0.0.1:8787",
      "aiApiUrl": "https://mig-farm-ai-backend.vercel.app/api/chat"
    }
  }
}
