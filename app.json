{
  "expo": {
    "name": "MIG FARM | ميغ فارم",
    "slug": "mig-farm-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "migfarm",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-mig-farm.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.migfarm.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.migfarm.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-mig-farm.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mig-farm.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يمكنك اختيار صورة للحساب، أو إرسال صورة نبات أو منتج للتحليل عند طلبك. صورة الحساب لا تُرسل للمساعد.",
          "cameraPermission": "نستخدم الكاميرا عند طلبك لالتقاط صورة اختيارية للحساب أو لتصوير نبات أو منتج.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        { "configureAndroidBackup": true, "faceIDPermission": false }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.migfarm.app",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://mig-farm-api.onrender.com",
      "aiApiUrl": "https://mig-farm-ai-backend.vercel.app/api/chat",
      "router": {},
      "eas": {
        "projectId": "c8afa207-58bc-4e62-9341-0b4d2e1b8661"
      }
    }
  }
}
