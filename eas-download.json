{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mig-farm-api.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mig-farm-api.onrender.com"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mig-farm-api.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
